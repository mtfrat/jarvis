# ==========================================
# Jarvis Finance - Configuración de Entorno
# ==========================================

# Telegram Bot (Obtenido de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_token_aqui

# Whitelist de IDs de Telegram autorizados (separados por coma, ej: 12345678,98765432)
# Obligatorio: si está vacío, el bot rechaza a TODOS los usuarios (fail-closed).
TELEGRAM_ALLOWED_USER_IDS=tu_telegram_user_id

# Secreto del dashboard web — generá uno con: openssl rand -hex 32
# Obligatorio: sin él la API (/api/expenses, /api/stats) responde 503.
# La UI lo envía como header x-dashboard-secret.
NEXT_PUBLIC_DASHBOARD_SECRET=tu_secreto_aqui

# Secreto del webhook de Telegram (header X-Telegram-Bot-Api-Secret-Token).
# Registrá el webhook con el mismo valor:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL>&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=tu_webhook_secret_aqui

# Google Gemini API (Obtenido gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key

# Supabase PostgreSQL (Obtenido en el dashboard de https://supabase.com/ -> Project Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key
